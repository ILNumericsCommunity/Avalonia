<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>ILNumerics.Community.Avalonia</RootNamespace>
        <AssemblyName>ILNumerics.Community.Avalonia</AssemblyName>
        <AssemblyVersion>7.0.0</AssemblyVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.3" />
        <PackageReference Include="ILNumerics.Core" Version="7.4.62" />
        <PackageReference Include="ILNumerics.Drawing" Version="7.4.62" />
        <PackageReference Include="MinVer" Version="8.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
</Project>
